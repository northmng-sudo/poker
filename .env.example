# KHAN POKER — Frontend environment variables (Vite)
# .env.local файлд хуулж бодит утгаараа солино уу. Энэ файл ГИТ-д commit
# хийгдэхгүй (.gitignore-д орсон).
#
# ⚠️ Зөвхөн Supabase "anon public" key энд байна. "service_role" key-г
# ХЭЗЭЭ Ч frontend .env файлд оруулахгүй, GitHub-д commit хийхгүй, client
# bundle-д оруулахгүй. Түүнийг зөвхөн Supabase Edge Function secret
# (`supabase secrets set`) хэлбэрээр л ашиглана.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# GitHub Pages project site бол "/YOUR_REPO_NAME/", custom domain эсвэл
# username.github.io үндсэн repo бол "/" гэж тохируулна.
VITE_APP_BASE_PATH=/khan-poker/
